# Normalize line endings: text files stored LF in the repo, checked out native.
* text=auto eol=lf

# Explicit text types
*.cs        text
*.cshtml    text
*.csproj    text
*.sln       text -crlf
*.json      text
*.css       text
*.js        text
*.md        text
*.yml       text
*.xml       text
*.svg       text
*.wsdl      text
*.xsd       text

# Binary assets — never normalize
*.png       binary
*.jpg       binary
*.woff      binary
*.woff2     binary
*.ico       binary
*.db        binary
