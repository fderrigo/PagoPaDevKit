@model PosizioniVm
@{
    ViewData["Title"] = "Posizioni debitorie";
    ViewData["Section"] = "Test Ente";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">Posizioni debitorie</h1>
    <a href="/ente/crea" class="btn btn-primary"><i class="bi bi-file-earmark-plus"></i> Crea posizione</a>
</div>

<form method="get" class="row g-2 mb-3 ppa-compact">
    <div class="col-sm-4">
        <input name="q" class="form-control" placeholder="Cerca per NAV o CF debitore" value="@Model.Q" />
    </div>
    <div class="col-sm-3">
        <div class="select-wrapper">
            <select name="stato" aria-label="Filtra per stato">
                <option value="">Tutti gli stati</option>
                @foreach (var s in new[] { "DA PAGARE", "PAGATO", "SCADUTO" })
                {
                    <option value="@s" selected="@(Model.Stato == s)">@s</option>
                }
            </select>
        </div>
    </div>
    <div class="col-sm-auto">
        <button class="btn btn-outline-secondary"><i class="bi bi-funnel"></i> Filtra</button>
        <a href="/ente/posizioni" class="btn btn-link">Azzera</a>
    </div>
</form>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <partial name="_DovutiTable" model="@(new DovutiTableVm { Dovuti = Model.Dovuti, Ofc = Model.Ofc })" />
    </div>
</div>
