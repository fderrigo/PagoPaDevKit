@model EsitoEnteVm
@{
    ViewData["Title"] = "Esito pagamento";
    ViewData["Section"] = "Test Cittadino";
    bool ok = Model.Outcome == "OK";
}

<div class="card shadow-sm mx-auto" style="max-width:560px">
    <div class="card-body text-center p-4">
        @if (ok)
        {
            <i class="bi bi-check-circle-fill text-success" style="font-size:3rem"></i>
            <h1 class="h4 mt-2">Pagamento riuscito</h1>
            <p class="text-secondary">L'esito è stato notificato all'ente. La posizione risulterà PAGATA e la ricevuta (RT) disponibile su GPD.</p>
        }
        else
        {
            <i class="bi bi-x-circle-fill text-danger" style="font-size:3rem"></i>
            <h1 class="h4 mt-2">Pagamento non riuscito</h1>
            <p class="text-secondary">Nessun addebito. Puoi riprovare il pagamento.</p>
        }

        @if (Model.Navs.Count > 0)
        {
            <div class="mb-3">
                @foreach (var n in Model.Navs)
                {
                    <span class="badge text-bg-light border me-1"><code>@n</code></span>
                }
            </div>
        }
        <div class="d-flex gap-2 justify-content-center">
            <a href="/ente/posizioni" class="btn btn-outline-secondary"><i class="bi bi-list-task"></i> Posizioni</a>
            <a href="/" class="btn btn-primary"><i class="bi bi-house-door"></i> Dashboard</a>
        </div>
    </div>
</div>
