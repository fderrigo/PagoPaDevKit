<!DOCTYPE html>
<html lang="it" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "PagoPaDevKit") · PagoPaDevKit</title>
    <script>if (localStorage.getItem('ppaNav') === 'collapsed') document.documentElement.classList.add('ppa-collapsed');</script>
    <link rel="stylesheet" href="~/lib/bootstrap-italia/css/bootstrap-italia.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-body-tertiary">
    <div class="d-flex">
        <!-- Sidebar desktop -->
        <aside class="ppa-sidebar d-none d-lg-block">
            @await Component.InvokeAsync("Sidebar")
        </aside>

        <!-- Sidebar mobile (offcanvas) -->
        <div class="offcanvas offcanvas-start ppa-sidebar text-bg-dark" tabindex="-1" id="sidebarOffcanvas">
            <div class="offcanvas-header">
                <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="offcanvas"></button>
            </div>
            <div class="offcanvas-body p-0">
                @await Component.InvokeAsync("Sidebar")
            </div>
        </div>

        <div class="ppa-content flex-grow-1 min-vw-0 d-flex flex-column min-vh-100">
            <!-- Header istituzionale nativo Bootstrap Italia (slim + center) -->
            <header class="it-header-wrapper ppa-noprint sticky-top">
                <div class="it-header-slim-wrapper">
                    <div class="container-fluid">
                        <div class="row">
                            <div class="col-12">
                                <div class="it-header-slim-wrapper-content">
                                    <button class="btn btn-sm text-white d-lg-none p-0 me-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarOffcanvas" aria-label="Apri il menu">
                                        <svg class="icon icon-white icon-sm"><use href="/lib/bootstrap-italia/svg/sprites.svg#it-burger"></use></svg>
                                    </button>
                                    <button class="btn btn-sm text-white d-none d-lg-inline-flex align-items-center p-0 me-2" type="button" onclick="ppaToggleNav()" aria-label="Comprimi/espandi menu" title="Comprimi/espandi menu">
                                        <svg class="icon icon-white icon-sm"><use href="/lib/bootstrap-italia/svg/sprites.svg#it-burger"></use></svg>
                                    </button>
                                    <a class="d-none d-lg-block navbar-brand" href="/">Console gestionale Ente</a>
                                    <div class="it-header-slim-right-zone">
                                        @await Component.InvokeAsync("Componenti")
                                        @await Component.InvokeAsync("EnvBadge")
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="it-nav-wrapper">
                    <div class="it-header-center-wrapper it-small-header">
                        <div class="container-fluid">
                            <div class="row">
                                <div class="col-12">
                                    <div class="it-header-center-content-wrapper">
                                        <div class="it-brand-wrapper">
                                            <a href="/">
                                                <svg class="icon"><use href="/lib/bootstrap-italia/svg/sprites.svg#it-pa"></use></svg>
                                                <div class="it-brand-text">
                                                    <div class="it-brand-title">PagoPaDevKit</div>
                                                    <div class="it-brand-tagline d-none d-md-block">Emulatore pagoPA · gestionale Ente Creditore</div>
                                                </div>
                                            </a>
                                        </div>
                                        <div class="it-right-zone">
                                            <nav aria-label="breadcrumb">
                                                <ol class="breadcrumb mb-0">
                                                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
                                                    @if (ViewData["Section"] is string sec && !string.IsNullOrEmpty(sec))
                                                    {
                                                        <li class="breadcrumb-item">@sec</li>
                                                    }
                                                    <li class="breadcrumb-item active">@(ViewData["Title"] ?? "")</li>
                                                </ol>
                                            </nav>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            <main class="p-3 p-lg-4 flex-grow-1">
                @{
                    var toast = TempData["Toast"] as string;
                    var toastKind = TempData["ToastKind"] as string ?? "success";
                }
                <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1100" id="toastArea">
                    @if (!string.IsNullOrEmpty(toast))
                    {
                        <div class="toast align-items-center border-0 text-bg-@toastKind" role="alert">
                            <div class="d-flex">
                                <div class="toast-body">@toast</div>
                                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                            </div>
                        </div>
                    }
                </div>

                @RenderBody()
            </main>

            <!-- Footer istituzionale nativo Bootstrap Italia -->
            <footer class="it-footer ppa-noprint mt-auto">
                <div class="it-footer-main">
                    <div class="container-fluid">
                        <section>
                            <div class="row clearfix">
                                <div class="col-sm-12">
                                    <div class="it-brand-wrapper">
                                        <a href="/" data-focus-mouse="false">
                                            <svg class="icon"><use xlink:href="/lib/bootstrap-italia/svg/sprites.svg#it-pa"></use></svg>
                                            <div class="it-brand-text">
                                                <h2 class="h4 mb-0">PagoPaDevKit</h2>
                                                <h3 class="h6 fw-normal d-none d-md-block mb-0">Emulatore locale pagoPA · progetto open source indipendente</h3>
                                            </div>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="py-4 border-white border-top">
                            <div class="row">
                                <div class="col-lg-6 col-md-6 pb-2">
                                    <h4 class="h6">Componenti della solution</h4>
                                    <div class="link-list-wrapper">
                                        <ul class="footer-list link-list clearfix">
                                            @await Component.InvokeAsync("Componenti", new { style = "footer" })
                                        </ul>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 pb-2">
                                    <h4 class="h6">Informazioni</h4>
                                    <p class="small mb-0"><strong>Progetto open source indipendente, non affiliato a PagoPA S.p.A. Emulatore a scopo di sviluppo e formazione, fornito senza alcuna garanzia.</strong> Interfaccia conforme alle Linee guida di design PA (Bootstrap Italia).</p>
                                </div>
                            </div>
                        </section>
                    </div>
                </div>
                <div class="it-footer-small-prints clearfix">
                    <div class="container-fluid">
                        <ul class="it-footer-small-prints-list list-inline mb-0 d-flex flex-column flex-md-row">
                            <li class="list-inline-item">Progetto open source indipendente, non affiliato a PagoPA S.p.A. Emulatore a scopo di sviluppo e formazione, fornito senza alcuna garanzia.</li>
                            <li class="list-inline-item"><a href="/documentazione">Documentazione</a></li>
                        </ul>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/bootstrap-italia/js/bootstrap-italia.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
            if (window.bootstrap && bootstrap.Tooltip) new bootstrap.Tooltip(el);
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
