@using PagoPaDevKit.DemoEnte.ViewComponents
@model List<ComponenteLink>
<div class="dropdown">
    <button class="btn btn-sm btn-outline-light dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="bi bi-grid-3x3-gap"></i> Componenti
    </button>
    <ul class="dropdown-menu dropdown-menu-end shadow">
        <li><h6 class="dropdown-header">Altre componenti della solution</h6></li>
        @foreach (var c in Model)
        {
            <li>
                <a class="dropdown-item d-flex align-items-start gap-2" href="@c.Url" target="_blank" rel="noopener">
                    <i class="bi @c.Icon mt-1"></i>
                    <span>@c.Label<br /><small class="text-secondary">@c.Descr</small></span>
                </a>
            </li>
        }
    </ul>
</div>
