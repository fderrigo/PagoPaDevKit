@model DashboardVm
@{
    ViewData["Title"] = "Dashboard";
    string euroD(decimal d) => d.ToString("N2", CultureInfo.GetCultureInfo("it-IT"));
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h1 class="h3 mb-0">Dashboard</h1>
        <div class="text-secondary">@Model.CompanyName · CF @Model.Ofc</div>
    </div>
    <div class="d-flex gap-2">
        <a href="/ente/crea" class="btn btn-primary"><i class="bi bi-file-earmark-plus"></i> Crea posizione</a>
        <form method="post" action="/infrastruttura/strumenti/seed" data-loading>
            <button class="btn btn-outline-secondary" data-loading-text="Genero..."><i class="bi bi-magic"></i> Seed demo</button>
        </form>
    </div>
</div>

<!-- Card riepilogo -->
<div class="row g-3 mb-4">
    @{
        (string Label, int Val, string Cls, string Icon)[] cards =
        {
            ("Posizioni totali", Model.Totali, "text-bg-primary", "bi-collection"),
            ("Da pagare", Model.DaPagare, "text-bg-warning", "bi-hourglass-split"),
            ("Pagati", Model.Pagati, "text-bg-success", "bi-check-circle"),
            ("Scaduti", Model.Scaduti, "text-bg-danger", "bi-x-octagon"),
        };
    }
    @foreach (var c in cards)
    {
        <div class="col-6 col-lg-3">
            <div class="card ppa-stat-card h-100 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="badge @c.Cls rounded-circle p-3 fs-5"><i class="bi @c.Icon"></i></span>
                    <div>
                        <div class="display-6">@c.Val</div>
                        <div class="text-secondary small">@c.Label</div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="row g-3">
    <!-- Ultime posizioni -->
    <div class="col-lg-8">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-body d-flex justify-content-between align-items-center">
                <span><i class="bi bi-list-task me-1"></i> Ultime posizioni</span>
                <a href="/ente/posizioni" class="small">Tutte le posizioni →</a>
            </div>
            <div class="card-body p-0">
                <partial name="_DovutiTable" model="@(new DovutiTableVm { Dovuti = Model.UltimiDovuti, Ofc = Model.Ofc, Compact = true })" />
            </div>
        </div>
    </div>

    <!-- Stato servizi -->
    <div class="col-lg-4">
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-body"><i class="bi bi-hdd-network me-1"></i> Stato servizi</div>
            <ul class="list-group list-group-flush" id="healthList">
                @foreach (var s in Model.Servizi)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center" data-health="@s.Name">
                        <span>@s.Name</span>
                        <span>
                            <small class="text-secondary me-2" data-health-latency>@(s.LatencyMs?.ToString() ?? "—") ms</small>
                            <span class="badge rounded-pill @(s.Healthy ? "text-bg-success" : "text-bg-danger")" data-health-dot>@(s.Healthy ? "online" : "offline")</span>
                        </span>
                    </li>
                }
            </ul>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-body d-flex justify-content-between align-items-center">
                <span><i class="bi bi-receipt me-1"></i> Ultime ricevute</span>
                <a href="/ente/ricevute" class="small">Tutte →</a>
            </div>
            <ul class="list-group list-group-flush">
                @if (Model.UltimeRicevute.Count == 0)
                {
                    <li class="list-group-item text-secondary small">Nessuna ricevuta ancora.</li>
                }
                @foreach (var r in Model.UltimeRicevute)
                {
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between">
                            <code class="small">@r.Iuv</code>
                            <strong>@euroD(r.PaymentAmount) €</strong>
                        </div>
                        <small class="text-secondary">@r.PspCompanyName · @r.PaymentDateTime.ToString("dd/MM/yyyy HH:mm")</small>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <script>startHealthPolling('/infrastruttura/health', 10000);</script>
}
